{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "bracketSameLine": true,
      "jsxQuoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noNestedTernary": "off",
        "useFilenamingConvention": "off"
      }
    }
  }
}
